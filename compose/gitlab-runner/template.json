{
  "schema": "boilerplates/template/v1",
  "slug": "gitlab-runner-compose",
  "kind": "compose",
  "metadata": {
    "name": "Gitlab-Runner",
    "description": "CI/CD build runner for GitLab pipelines. Executes jobs defined in .gitlab-ci.yml using the Docker executor.",
    "tags": [],
    "icon": {
      "provider": "simple-icons",
      "id": "gitlab",
      "color": "orange"
    },
    "draft": false
  },
  "variables": [
    {
      "title": "General",
      "name": "general",
      "items": [
        {
          "name": "service_name",
          "type": "str",
          "title": "Service Name",
          "required": true,
          "default": "gitlab-runner",
          "config": {
            "placeholder": "gitlab-runner"
          }
        },
        {
          "name": "container_name",
          "type": "str",
          "title": "Container Name",
          "required": false,
          "default": "gitlab-runner",
          "config": {
            "placeholder": "gitlab-runner"
          }
        },
        {
          "name": "restart_policy",
          "type": "enum",
          "title": "Restart Policy",
          "required": true,
          "default": "unless-stopped",
          "config": {
            "options": [
              "unless-stopped",
              "always",
              "on-failure",
              "no"
            ]
          }
        }
      ]
    }
  ]
}
