{
  "schema": "boilerplates/template/v1",
  "slug": "core-secret-kubernetes",
  "kind": "kubernetes",
  "metadata": {
    "name": "External Secret",
    "description": "Reference credentials in an existing external secret store; requires External Secrets Operator.",
    "tags": [],
    "icon": {
      "provider": "simple-icons",
      "id": "kubernetes",
      "color": "blue"
    },
    "draft": false
  },
  "variables": [
    {
      "name": "general",
      "title": "External Secret",
      "items": [
        {
          "name": "resource_name",
          "type": "str",
          "title": "Resource Name",
          "required": false,
          "default": "api-token-secret",
          "config": {
            "placeholder": "api-token-secret"
          }
        },
        {
          "name": "secret_store_name",
          "type": "str",
          "title": "Secret Store Name",
          "required": true,
          "default": "secret-store"
        },
        {
          "name": "remote_secret_key",
          "type": "str",
          "title": "Remote Secret Key",
          "required": true,
          "default": "app/api-token"
        }
      ]
    }
  ]
}
