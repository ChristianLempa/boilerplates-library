{
  "schema": "boilerplates/template/v1",
  "slug": "certmanager-webhook-netcup-secret-kubernetes",
  "kind": "kubernetes",
  "metadata": {
    "name": "Cert-Manager Netcup External Secret",
    "description": "Reference credentials in an existing external secret store; requires External Secrets Operator.",
    "tags": [
      "cert-manager",
      "netcup",
      "dns01",
      "secret"
    ],
    "icon": {
      "provider": "simple-icons",
      "id": "netcup",
      "color": "emerald"
    },
    "draft": false
  },
  "variables": [
    {
      "name": "general",
      "title": "External Secret",
      "items": [
        {
          "name": "resource_name",
          "type": "str",
          "title": "Secret name",
          "required": false,
          "default": "netcup-secret",
          "config": {
            "placeholder": "netcup-secret"
          }
        },
        {
          "name": "secret_store_name",
          "type": "str",
          "title": "Secret Store Name",
          "required": true,
          "default": "secret-store"
        },
        {
          "name": "remote_secret_key",
          "type": "str",
          "title": "Remote Secret Key",
          "required": true,
          "default": "netcup"
        }
      ]
    }
  ]
}
