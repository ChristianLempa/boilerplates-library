{
  "slug": "dns-a-record-tsig-terraform",
  "kind": "terraform",
  "metadata": {
    "name": "DNS Record A (TSIG)",
    "description": "Creates a DNS A record using TSIG-authenticated dynamic DNS updates. Maps a hostname to an IP address on a TSIG-enabled DNS server.",
    "icon": {
      "provider": "lucide",
      "id": "globe",
      "color": "violet"
    },
    "version": {
      "name": "3.5.0",
      "source_dep_name": "hashicorp/dns",
      "source_dep_version": "3.5.0"
    },
    "draft": false
  },
  "variables": [
    {
      "name": "record",
      "title": "DNS Record Configuration",
      "items": [
        {
          "name": "dns_hostname",
          "type": "str",
          "title": "Hostname",
          "required": true,
          "config": {
            "placeholder": "hostname"
          }
        },
        {
          "name": "dns_zone",
          "type": "str",
          "title": "Zone",
          "required": true,
          "config": {
            "placeholder": "home.arpa."
          }
        },
        {
          "name": "ip_address",
          "type": "str",
          "title": "IP Address",
          "required": true,
          "config": {
            "placeholder": "192.168.0.1/24"
          }
        },
        {
          "name": "dns_ttl",
          "type": "int",
          "title": "TTL",
          "required": false,
          "default": 3600,
          "description": "Time to live (TTL) for the DNS record in seconds (default: 3600)",
          "config": {
            "placeholder": "3600",
            "unit": "seconds",
            "slider": true,
            "min": 60,
            "max": 86400,
            "step": 60
          }
        }
      ]
    }
  ]
}
